# Production environment variables example for Vercel
# Copy values into Vercel Project Settings -> Environment Variables

# Database
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Supabase (public keys must start with NEXT_PUBLIC_ to be available client-side)
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-publishable-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="files"

# NextAuth
NEXTAUTH_URL="https://your-production-url"
NEXTAUTH_SECRET="generate-a-secure-random-secret"

# AWS (optional - only required if using S3)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="your-aws-secret"
AWS_S3_BUCKET_NAME="clouddrive-storage"

# App settings
MAX_FILE_SIZE="104857600"
SIGNED_URL_EXPIRATION="3600"
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# Optional: Logging / Sentry / Other third-party keys
# SENTRY_DSN="https://...@sentry.io/..."
